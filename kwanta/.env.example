# ── Core ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of this server (used to build the ad SSV callback URL)
PUBLIC_BASE_URL=https://rewards.yourdomain.co.za

# ── Security (CHANGE THESE) ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
# Shared secret for networks that sign S2S reward callbacks with HMAC.
# Give this exact value to your ad-network dashboard, or keep it for the
# built-in AdMob-style RSA verification path (which uses Google's public keys).
AD_SSV_HMAC_SECRET=replace_me_with_another_long_random_string
# Comma-separated admin emails allowed to review/approve payouts.
ADMIN_EMAILS=you@yourdomain.co.za

# ── Economics (THIS is where you earn) ───────────────────────────
# What the ad network pays YOU per rewarded view, in ZAR cents.
# Set from your real eCPM: eCPM_ZAR / 1000 * 100. Used only for reporting.
REVENUE_PER_AD_CENTS=0.20
# What you CREDIT the user per verified rewarded view, in points.
# 1 point = 1 ZAR cent in this build (see POINT_VALUE_CENTS).
POINTS_PER_AD=1
POINT_VALUE_CENTS=1
# Your margin is (REVENUE_PER_AD_CENTS - POINTS_PER_AD*POINT_VALUE_CENTS).
# Keep POINTS_PER_AD*POINT_VALUE_CENTS well below REVENUE_PER_AD_CENTS.

# ── Payout rules ─────────────────────────────────────────────────
MIN_PAYOUT_POINTS=5000
# Hard cap on rewarded ads credited per user per day (fraud control).
MAX_ADS_PER_DAY=25
# Require phone OTP verification before a user can request payout.
REQUIRE_PHONE_VERIFICATION=true

# ── Integrations (stubs until you add real keys) ─────────────────
# SMS provider for OTP (e.g. Clickatell, Twilio). Blank = console OTP in dev.
SMS_PROVIDER_KEY=
# Payout provider (e.g. Flutterwave, Peach). Blank = manual payouts.
PAYOUT_PROVIDER_KEY=

# ── Ad network: Google AdSense H5 Games Ads (free) ───────────────
# Your AdSense Publisher ID. Leave blank to run with the simulated ad in dev.
# Get it after your AdSense account + H5 Games Ads allowlisting is approved.
ADSENSE_CLIENT=
# How often the API may show ads (hint).
AD_FREQUENCY_HINT=30s
